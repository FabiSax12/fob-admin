  "components": [
    {
      "name": "ThemedButton",
      "group": "Actions",
      "summary": "The brand's signature button: an amber hairline outline with a gold label, for every main call to action."
    },
    {
      "name": "Button",
      "group": "Actions",
      "summary": "The shadcn/ui button (new-york style), mapped onto the FOB palette through the shadcn variables."
    },
    {
      "name": "TextField",
      "group": "Forms",
      "summary": "A labelled text input or textarea in the contact form's style: uppercase muted label, color-fob-900 field, 2px corners, amber focus."
    },
    {
      "name": "GenreTabs",
      "group": "Navigation",
      "summary": "A row of serif tabs that switch the repertoire between genres, with a gold underline that slides in under the selected one."
    },
    {
      "name": "Card",
      "group": "Cards",
      "summary": "The shadcn/ui card: a card surface with a 1px border hairline and soft corners, split into header, title, description, content and footer parts."
    },
    {
      "name": "EventCard",
      "group": "Cards",
      "summary": "One row of the events list: a gold serif date block on the left, the event's name, venue, start time and ticket chips beside it."
    },
    {
      "name": "BandMemberCard",
      "group": "Cards",
      "summary": "A musician's 3:4 portrait over their name in Gloock and instrument in small uppercase."
    },
    {
      "name": "SectionTitle",
      "group": "Typography",
      "summary": "The heading that opens every home-page section: Gloock in color-fob-text with a short amber rule beneath."
    },
    {
      "name": "TextGradient",
      "group": "Typography",
      "summary": "A gold serif accent for one or two words inside a heading."
    },
    {
      "name": "MessageDialog",
      "group": "Feedback",
      "summary": "A centered confirmation over a dark veil, used after the contact form submits."
    },
    {
      "name": "Gradients",
      "group": "Foundations",
      "page": true
    }
  ],
